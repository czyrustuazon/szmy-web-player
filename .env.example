# Copy to .env and edit: cp .env.example .env

# Host folder with your music (mounted at /music). Delete and upload write here.
LIBRARY_HOST_PATH=./music

# Host folder for state, transcode cache and the error log (mounted at /data).
DATA_HOST_PATH=./data

# WHERE UPLOADS ARE STORED on the host (shown in the library as uploads/). The default,
# ./uploads, is a folder next to this project, i.e. on the main disk. To keep uploads somewhere
# else, for example a big drive, point it there:  UPLOADS_HOST_PATH=/mnt/anime-drive/music-uploads
# Unfinished uploads are staged inside this same folder, so they never touch another disk.
UPLOADS_HOST_PATH=./uploads

# ---- WHO MAY CONNECT --------------------------------------------------------------------
# Like animedb.haruhi.one: only your own devices. Every connection is checked by the address it
# really comes from (headers like X-Forwarded-For are ignored, anyone can forge those).
#
# Networks allowed to connect. Default: your Tailscale network plus your home network; the public
# internet is refused, so a router port-forward cannot expose the player. Items (comma separated):
# tailscale (100.64.0.0/10), lan (10/8, 172.16/12, 192.168/16, fc00::/7), loopback, any, or your own
# CIDR such as 192.168.1.0/24. For the tailnet only (nothing from the home network directly), use:
#   MP_ALLOWED_NETS=tailscale
MP_ALLOWED_NETS=tailscale,lan

# Also require Tailscale devices to be YOURS: a comma separated list of device names as shown by
# `tailscale status` (the same idea as KNOWN_DEVICES in anime-db-stream). The name comes from this
# host's own tailscaled, so another person's node in a shared tailnet cannot get in. Leave empty
# to allow every device on your tailnet. Needs tailscaled running on this host (the Makefile then
# mounts its socket). Devices on the home network are allowed by the networks above.
MP_KNOWN_DEVICES=

# Listen only on this host's Tailscale address (`tailscale ip -4`), like BIND_ADDR in
# anime-db-stream, e.g. BIND_ADDR=100.114.200.30. 0.0.0.0 listens on every IPv4 interface (the
# allowed networks above still apply). With a Tailscale address, reach the player at
# http://<that address>:PORT or at a DNS name that points to it.
BIND_ADDR=0.0.0.0

# Host port the web UI is published on (the container always listens on 8080 inside).
PORT=8787

# Your host user, so deleted and uploaded files keep your ownership: `id -u` and `id -g`.
PUID=1000
PGID=1000

# Login password. Leave EMPTY for open access (no login): anyone who can reach the port
# can play, upload and delete. Set a value to require sign-in.
MP_ADMIN_PASSWORD=

# Set to true to disable delete and upload even though the library folder is writable.
MP_READ_ONLY=false

# Set to true when serving over HTTPS (for example behind a reverse proxy).
MP_COOKIE_SECURE=false

# Largest single upload (and largest archive once unpacked), in MB. 61440 = 60 GiB.
MP_MAX_UPLOAD_MB=61440

# Free space, in MB, that must remain on the library disk after an upload (0 = no check).
MP_MIN_FREE_MB=1024

# Hours before an abandoned upload (never resumed) is cleaned up.
MP_UPLOAD_TTL_HOURS=48
